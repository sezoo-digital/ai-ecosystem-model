<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:y="http://www.yworks.com/xml/graphml"
         xmlns:yed="http://www.yworks.com/xml/yed/3">
  <key for="node" id="d_graphics" yfiles.type="nodegraphics"/>
  <key for="edge" id="d_edge_graphics" yfiles.type="edgegraphics"/>
  <key for="node" id="d_sublabel" attr.name="sublabel" attr.type="string"/>
  <key for="node" id="d_props" attr.name="properties" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <node id="N_TRAIN">
      <data key="d_sublabel">Data Curators, Annotators, Compute</data>
      <data key="d_props">cost_type: Fixed / R&amp;D CapEx</data>
      <data key="d_graphics">
        <y:ShapeNode>
          <y:Geometry width="220" height="70"/>
          <y:Fill color="#F8FAFC" transparent="false"/>
          <y:BorderStyle color="#1E40AF" type="line" width="2.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content">Training Supply Chain
(Data Curators, Annotators, Compute)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="N_FRONTIER">
      <data key="d_sublabel">Weights &amp; Wholesale Inference API</data>
      <data key="d_props">pricing_model: Per-Token Usage | liability_posture: Disclaimed via ToS</data>
      <data key="d_graphics">
        <y:ShapeNode>
          <y:Geometry width="220" height="70"/>
          <y:Fill color="#F8FAFC" transparent="false"/>
          <y:BorderStyle color="#1E40AF" type="line" width="2.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content">Frontier Model Instance
(Weights &amp; Wholesale Inference API)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="N_ABSORBED">
      <data key="d_sublabel">Native Tools, Prompt Cache, Hosted State</data>
      <data key="d_props">market_effect: Encroachment on ISVs</data>
      <data key="d_graphics">
        <y:ShapeNode>
          <y:Geometry width="220" height="70"/>
          <y:Fill color="#F8FAFC" transparent="false"/>
          <y:BorderStyle color="#1E40AF" type="line" width="2.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content">Platform Absorption Zone
(Native Tools, Prompt Cache, Hosted State)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="N_ISV_PRODUCT">
      <data key="d_sublabel">Vertical Solutions (Legal, Medical, Finance)</data>
      <data key="d_props">pricing_model: SaaS Seat / Outcome Pricing | margin_profile: High Gross Margin (Vulnerable)</data>
      <data key="d_graphics">
        <y:ShapeNode>
          <y:Geometry width="220" height="70"/>
          <y:Fill color="#F8FAFC" transparent="false"/>
          <y:BorderStyle color="#1E40AF" type="line" width="2.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content">Specialized AI Product
(Vertical Solutions (Legal, Medical, Finance))</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="N_ENTERPRISE">
      <data key="d_sublabel">Budget Holder &amp; Legal Entity</data>
      <data key="d_props">liability_posture: Holds Vicarious Legal Liability | commercial_role: Economic Sponsor</data>
      <data key="d_graphics">
        <y:ShapeNode>
          <y:Geometry width="220" height="70"/>
          <y:Fill color="#F8FAFC" transparent="false"/>
          <y:BorderStyle color="#1E40AF" type="line" width="2.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content">Enterprise Principal
(Budget Holder &amp; Legal Entity)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <edge id="e0" source="N_ENTERPRISE" target="N_ISV_PRODUCT">
      <data key="d_edge_graphics">
        <y:PolyLineEdge>
          <y:LineStyle color="#16A34A" type="line" width="2.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel alignment="center">$$$ High-Margin SaaS / Outcome Contract</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e1" source="N_ISV_PRODUCT" target="N_FRONTIER">
      <data key="d_edge_graphics">
        <y:PolyLineEdge>
          <y:LineStyle color="#16A34A" type="line" width="2.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel alignment="center">$$ Wholesale Token Consumption</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e2" source="N_FRONTIER" target="N_TRAIN">
      <data key="d_edge_graphics">
        <y:PolyLineEdge>
          <y:LineStyle color="#16A34A" type="line" width="2.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel alignment="center">$ Compute &amp; Annotation CapEx</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
    <edge id="e3" source="N_ABSORBED" target="N_ISV_PRODUCT">
      <data key="d_edge_graphics">
        <y:PolyLineEdge>
          <y:LineStyle color="#1E40AF" type="line" width="2.0"/>
          <y:Arrows source="none" target="standard"/>
          <y:EdgeLabel alignment="center">Platform Commoditization Pressure</y:EdgeLabel>
        </y:PolyLineEdge>
      </data>
    </edge>
  </graph>
</graphml>