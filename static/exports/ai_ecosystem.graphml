<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns"
         xmlns:y="http://www.yworks.com/xml/graphml"
         xmlns:yed="http://www.yworks.com/xml/yed/3">
  <key for="node" id="d_graphics" yfiles.type="nodegraphics"/>
  <key for="edge" id="d_edge_graphics" yfiles.type="edgegraphics"/>
  <key for="node" id="d_cluster" attr.name="cluster" attr.type="string"/>
  <key for="node" id="d_domains" attr.name="domains" attr.type="string"/>
  <key for="node" id="d_sublabel" attr.name="sublabel" attr.type="string"/>
  <key for="node" id="d_properties" attr.name="properties" attr.type="string"/>
  <key for="edge" id="d_edge_domains" attr.name="domains" attr.type="string"/>
  <key for="edge" id="d_edge_type" attr.name="type" attr.type="string"/>
  <graph id="G" edgedefault="directed">
    <node id="N_TRAIN">
      <data key="d_cluster">cluster_supply</data>
      <data key="d_domains">economic, technical</data>
      <data key="d_sublabel">Data Curators, Annotators, Compute</data>
      <data key="d_properties">cost_type: Fixed / R&amp;D CapEx</data>
      <data key="d_graphics">
        <y:ShapeNode>
          <y:Geometry width="220" height="70"/>
          <y:Fill color="#F8FAFC" transparent="false"/>
          <y:BorderStyle color="#1E40AF" type="line" width="2.0"/>
          <y:NodeLabel alignment="center" autoSizePolicy="content">Training Supply Chain
(Data Curators, Annotators, Compute)</y:NodeLabel>
          <y:Shape type="roundrectangle"/>
        </y:ShapeNode>
      </data>
    </node>
    <node id="N_FRONTIER">
